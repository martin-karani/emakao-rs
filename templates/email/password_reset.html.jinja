{% extends "base.html.jinja" %}

{% block title %}Reset Your Emakao Password{% endblock %}
{% block preheader %}Use this secure link to reset your Emakao password. It expires in 1 hour.{% endblock %}

{% block content %}
<h1>Reset your password.</h1>
<p>Hi {{ first_name | default("there") }},</p>
<p>
  We received a request to reset the password for your Emakao account.
  Use the secure button below to choose a new password.
</p>
<div class="cta-wrap">
  <a href="{{ reset_url }}" class="cta">Reset My Password</a>
</div>
<div class="highlight-box">
  <p style="margin:0 0 8px;"><strong>This link expires in 1 hour.</strong></p>
  <p style="margin:0;">
    If you did not request a password reset, you can safely ignore this email.
    Your password will remain unchanged.
  </p>
</div>
<p class="small-text">
  If the button does not work, copy and paste this link into your browser:<br>
  <a href="{{ reset_url }}">{{ reset_url }}</a>
</p>
{% endblock %}
