{% extends "base.html.jinja" %}

{% block title %}Reset Your Emakao Password{% endblock %}

{% block content %}
<h2>Reset Your Password</h2>
<p>Hi {{ first_name | default("there") }},</p>
<p>
  We received a request to reset the password for your Emakao account.
  Click the button below to choose a new password.
</p>
<p>
  <a href="{{ reset_url }}" class="cta">Reset My Password</a>
</p>
<div class="highlight-box">
  <strong>This link expires in 1 hour.</strong><br>
  If you did not request a password reset, you can safely ignore this email —
  your password will remain unchanged.
</div>
<p style="font-size:13px;color:#555555;">
  Having trouble with the button? Copy and paste this link into your browser:<br>
  <a href="{{ reset_url }}" style="color:#1a3c5e;">{{ reset_url }}</a>
</p>
{% endblock %}
