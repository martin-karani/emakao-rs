{% extends "base.html.jinja" %}

{% block title %}Welcome to Emakao – Resident Portal{% endblock %}

{% block content %}
<h2>You've been invited to the Resident Portal</h2>
<p>Hi {{ first_name }},</p>
<p>
  You have been added as a resident by <strong>{{ agency_name | default("your property manager") }}</strong>.
  Click the button below to activate your account and access your resident portal.
</p>
<div class="highlight-box">
  <strong>What you can do in the Resident Portal:</strong><br>
  View your lease &amp; payment history, submit maintenance requests, and message your property manager.
</div>
<p>
  <a href="{{ invite_url }}" class="cta">Activate Your Account</a>
</p>
<p style="font-size:13px;color:#888888;">
  This link expires in <strong>48 hours</strong>. If you did not expect this invitation,
  you can safely ignore this email.
</p>
<hr class="divider">
<p style="font-size:13px;color:#555555;">
  Having trouble with the button? Copy and paste this link into your browser:<br>
  <a href="{{ invite_url }}" style="color:#1a3c5e;">{{ invite_url }}</a>
</p>
{% endblock %}
