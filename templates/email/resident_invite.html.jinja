{% extends "base.html.jinja" %}

{% block title %}Welcome to Emakao – Resident Portal{% endblock %}
{% block preheader %}Activate your resident portal to view lease details, payments, and maintenance updates.{% endblock %}

{% block content %}
<h1>Your resident portal is ready.</h1>
<p>Hi {{ first_name }},</p>
<p>
  <strong>{{ agency_name | default("your property manager") }}</strong> has invited you
  to activate your Emakao resident portal.
</p>
<div class="highlight-box">
  <p class="section-label">From your portal, you can</p>
  <ul class="bullet-list">
    <li>View lease details and payment history.</li>
    <li>Submit maintenance requests and track progress.</li>
    <li>Stay connected with your property manager.</li>
  </ul>
</div>
<p>
  Use the secure link below to activate your account. The invitation expires in
  <strong>48 hours</strong>.
</p>
<div class="cta-wrap">
  <a href="{{ invite_url }}" class="cta">Activate Your Account</a>
</div>
<p class="note">
  If you did not expect this invitation,
  you can safely ignore this email.
</p>
<hr class="divider">
<p class="small-text">
  If the button does not work, copy and paste this link into your browser:<br>
  <a href="{{ invite_url }}">{{ invite_url }}</a>
</p>
{% endblock %}
