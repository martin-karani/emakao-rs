{% extends "base.html.jinja" %}

{% block title %}You've Been Invited to the Emakao Staff Dashboard{% endblock %}
{% block preheader %}Activate your staff account and start managing operations for {{ agency_name | default("your agency") }}.{% endblock %}

{% block content %}
<h1>Welcome to the team, {{ first_name }}.</h1>
<p>Hi {{ first_name }},</p>
<p>
  <strong>{{ inviter_name }}</strong> has invited you to join
  <strong>{{ agency_name | default("Emakao") }}</strong> as a
  <strong>{{ role | replace("_", " ") | title }}</strong> on Emakao.
</p>

<div class="highlight-box">
  <p class="section-label">Your access includes</p>
  {% if role == "admin" %}
    <ul class="bullet-list">
      <li>Manage properties, units, residents, owners, vendors, and staff.</li>
      <li>Review financial performance, agreements, maintenance workflows, and agency settings.</li>
      <li>Oversee day-to-day operations across the full portfolio.</li>
    </ul>
  {% elif role == "manager" %}
    <ul class="bullet-list">
      <li>Oversee properties and units across the agency.</li>
      <li>Manage lease activity, maintenance requests, and payment workflows.</li>
      <li>Monitor performance and keep operations moving smoothly.</li>
    </ul>
  {% else %}
    <ul class="bullet-list">
      <li>Work with assigned properties and day-to-day tasks.</li>
      <li>Support residents, follow up on requests, and track operational updates.</li>
      <li>Stay aligned with the rest of the property team in one dashboard.</li>
    </ul>
  {% endif %}
</div>

<p>
  Use the secure link below to activate your account and create your password.
  For your security, this invitation expires in <strong>48 hours</strong>.
</p>

<div class="cta-wrap">
  <a href="{{ invite_url }}" class="cta">Activate Your Account</a>
</div>

<p class="note">
  If you were not expecting this invitation, please contact
  <strong>{{ agency_name | default("Emakao") }}</strong> or ignore this email.
  Your account will not be activated unless you use the link above.
</p>

<hr class="divider">

<p class="small-text">
  If the button does not work, copy and paste this link into your browser:<br>
  <a href="{{ invite_url }}">{{ invite_url }}</a>
</p>
{% endblock %}
