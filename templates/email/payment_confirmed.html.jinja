{% extends "base.html.jinja" %}

{% block title %}Payment Received – Thank You{% endblock %}
{% block preheader %}We have received your payment of KES {{ amount_kes }}.{% endblock %}

{% block content %}
<h1>Payment received.</h1>
<p>Hi {{ resident_name }},</p>
<p>
  We have successfully received your payment. Thank you for settling your account.
</p>
<div class="highlight-box">
  <p class="section-label">Payment summary</p>
  <table class="meta-table">
    <tr>
      <td class="meta-label">Amount paid</td>
      <td class="meta-value">KES {{ amount_kes }}</td>
    </tr>
    <tr>
      <td class="meta-label">Reference</td>
      <td class="meta-value">{{ reference }}</td>
    </tr>
    {% if payment_date %}
    <tr>
      <td class="meta-label">Date</td>
      <td class="meta-value-soft">{{ payment_date }}</td>
    </tr>
    {% endif %}
    {% if unit_ref %}
    <tr>
      <td class="meta-label">Unit</td>
      <td class="meta-value-soft">{{ unit_ref }}</td>
    </tr>
    {% endif %}
  </table>
</div>
<p class="note">
  Please keep this reference number for your records.
  You can view your full payment history in the resident portal.
</p>
{% endblock %}
