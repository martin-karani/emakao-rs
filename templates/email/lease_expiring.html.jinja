{% extends "base.html.jinja" %}

{% block title %}Your Lease Is Expiring Soon{% endblock %}
{% block preheader %}Your lease for {{ unit_ref }} is nearing its end date on {{ expiry_date }}.{% endblock %}

{% block content %}
<h1>Your lease is expiring soon.</h1>
<p>Hi {{ resident_name }},</p>
<p>
  We wanted to give you advance notice that your lease for
  <strong>{{ unit_ref }}</strong> is approaching its end date.
</p>
<div class="highlight-box">
  <p class="section-label">Lease details</p>
  <table class="meta-table">
    <tr>
      <td class="meta-label">Unit</td>
      <td class="meta-value">{{ unit_ref }}</td>
    </tr>
    <tr>
      <td class="meta-label">Expiry date</td>
      <td class="meta-value">{{ expiry_date }}</td>
    </tr>
    <tr>
      <td class="meta-label">Days remaining</td>
      <td class="meta-value">{{ days_remaining }} days</td>
    </tr>
  </table>
</div>
<p>
  Please contact your property manager as soon as possible if you would like to renew
  your lease or make alternative arrangements.
</p>
<p class="note">
  If you have already discussed your renewal, please disregard this notice.
</p>
{% endblock %}
