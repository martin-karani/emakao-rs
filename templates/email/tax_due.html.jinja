{% extends "base.html.jinja" %}

{% block title %}KRA Tax Obligation Due – Action Required{% endblock %}
{% block preheader %}A KRA obligation for {{ owner_name }} is due in {{ days_until_due }} day{% if days_until_due != "1" %}s{% endif %}.{% endblock %}

{% block content %}
<h1>KRA tax obligation due.</h1>
<p>Hi,</p>
<p>
  A KRA tax obligation for <strong>{{ owner_name }}</strong> is due in
  <strong>{{ days_until_due }} day{% if days_until_due != "1" %}s{% endif %}</strong>.
  Please file and pay on iTax before the due date to avoid penalties.
</p>

<div class="highlight-box">
  <p class="section-label">Obligation summary</p>
  <table class="meta-table">
    <tr>
      <td class="meta-label">Tax type</td>
      <td class="meta-value">{{ obligation_type }}</td>
    </tr>
    <tr>
      <td class="meta-label">Period</td>
      <td class="meta-value">{{ tax_period }}</td>
    </tr>
    <tr>
      <td class="meta-label">Amount due</td>
      <td class="meta-value">KES {{ tax_kes }}</td>
    </tr>
    <tr>
      <td class="meta-label">Due date</td>
      <td class="meta-value">{{ due_date }}</td>
    </tr>
    <tr>
      <td class="meta-label">Property</td>
      <td class="meta-value-soft">{{ property_address }}</td>
    </tr>
  </table>
</div>

<div class="cta-wrap">
  <a href="{{ itax_url }}" class="cta">File on iTax Now</a>
</div>

<p class="note">
  Late filing attracts a penalty of 5% of the tax due or KES 2,000 (whichever is higher),
  plus 1% interest per month on any unpaid balance.
  If you have already filed, you can disregard this reminder.
</p>
{% endblock %}
