{% extends "base.html.jinja" %}

{% block title %}Welcome to the Emakao Vendor Directory{% endblock %}
{% block preheader %}Activate vendor access to review assigned jobs and update work order progress.{% endblock %}

{% block content %}
<h1>You have been added to the vendor directory.</h1>
<p>Hi {{ contact_name | default("there") }},</p>
<p>
  <strong>{{ agency_name | default("A property management agency") }}</strong> has added
  <strong>{{ vendor_name }}</strong> to their vendor directory on Emakao.
  Activate your portal access to review assigned work orders and update job status.
</p>
<div class="highlight-box">
  <p class="section-label">Inside the vendor portal</p>
  <ul class="bullet-list">
    <li>View and respond to assigned work orders.</li>
    <li>Share progress updates and upload completion photos.</li>
    <li>Track job history in one place.</li>
  </ul>
</div>
<p>
  Activate your access below. The invitation link expires in <strong>48 hours</strong>.
</p>
<div class="cta-wrap">
  <a href="{{ invite_url }}" class="cta">Activate Portal Access</a>
</div>
<p class="note">
  If you did not expect this invitation,
  you can safely ignore this email.
</p>
<hr class="divider">
<p class="small-text">
  If the button does not work, copy and paste this link into your browser:<br>
  <a href="{{ invite_url }}">{{ invite_url }}</a>
</p>
{% endblock %}
