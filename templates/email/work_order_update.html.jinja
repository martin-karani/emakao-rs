{% extends "base.html.jinja" %}

{% block title %}Work Order Status Update{% endblock %}
{% block preheader %}There is a new update on work order #{{ work_order_ref }}.{% endblock %}

{% block content %}
<h1>Work order update.</h1>
<p>Hi {{ resident_name | default("there") }},</p>
<p>
  There is a new update on your maintenance request.
</p>
<div class="highlight-box">
  <p class="section-label">Request details</p>
  <table class="meta-table">
    <tr>
      <td class="meta-label">Work order</td>
      <td class="meta-value">#{{ work_order_ref }}</td>
    </tr>
    <tr>
      <td class="meta-label">Category</td>
      <td class="meta-value-soft">{{ category }}</td>
    </tr>
    <tr>
      <td class="meta-label">Status</td>
      <td class="meta-value" style="text-transform:capitalize;">{{ status }}</td>
    </tr>
    {% if scheduled_at %}
    <tr>
      <td class="meta-label">Scheduled</td>
      <td class="meta-value-soft">{{ scheduled_at }}</td>
    </tr>
    {% endif %}
    {% if vendor_name %}
    <tr>
      <td class="meta-label">Assigned to</td>
      <td class="meta-value-soft">{{ vendor_name }}</td>
    </tr>
    {% endif %}
  </table>
</div>
{% if description %}
<p>
  <strong>Notes:</strong> {{ description }}
</p>
{% endif %}
<p class="note">
  If you have questions about this work order, please contact your property manager.
</p>
{% endblock %}
