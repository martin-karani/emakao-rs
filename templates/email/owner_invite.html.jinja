{% extends "base.html.jinja" %}

{% block title %}Welcome to Emakao – Owner Portal{% endblock %}
{% block preheader %}Activate your owner portal to track property performance, statements, and disbursements.{% endblock %}

{% block content %}
<h1>Activate your owner portal.</h1>
<p>Hi {{ first_name }},</p>
<p>
  You have been added as a property owner with
  <strong>{{ agency_name | default("Emakao") }}</strong>.
  Activate your account to start tracking property performance, viewing statements,
  and staying up to date with disbursements.
</p>
<div class="highlight-box">
  <p class="section-label">Inside the owner portal</p>
  <ul class="bullet-list">
    <li>View occupancy and rent collection updates.</li>
    <li>Download statements and review account activity.</li>
    <li>Monitor maintenance activity affecting your property.</li>
  </ul>
</div>
<p>
  Your activation link remains valid for <strong>48 hours</strong>.
</p>
<div class="cta-wrap">
  <a href="{{ invite_url }}" class="cta">Activate Your Account</a>
</div>
<p class="note">
  If you did not expect this invitation,
  please contact your property manager.
</p>
<hr class="divider">
<p class="small-text">
  If the button does not work, copy and paste this link into your browser:<br>
  <a href="{{ invite_url }}">{{ invite_url }}</a>
</p>
{% endblock %}
