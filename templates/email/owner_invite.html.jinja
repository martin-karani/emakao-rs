{% extends "base.html.jinja" %}

{% block title %}Welcome to Emakao – Owner Portal{% endblock %}

{% block content %}
<h2>Activate Your Owner Portal</h2>
<p>Hi {{ first_name }},</p>
<p>
  You have been onboarded as a property owner with
  <strong>{{ agency_name | default("Emakao") }}</strong>.
  Activate your account to start tracking your properties, viewing statements, and receiving disbursements.
</p>
<div class="highlight-box">
  <strong>What you can do in the Owner Portal:</strong><br>
  View occupancy reports, track rent collection, download statements, and monitor maintenance activity.
</div>
<p>
  <a href="{{ invite_url }}" class="cta">Activate Your Account</a>
</p>
<p style="font-size:13px;color:#888888;">
  This link expires in <strong>48 hours</strong>. If you did not expect this invitation,
  please contact your property manager.
</p>
<hr class="divider">
<p style="font-size:13px;color:#555555;">
  Having trouble with the button? Copy and paste this link into your browser:<br>
  <a href="{{ invite_url }}" style="color:#1a3c5e;">{{ invite_url }}</a>
</p>
{% endblock %}
