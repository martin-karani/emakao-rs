{% extends "base.html.jinja" %}

{% block title %}Rent Payment Reminder{% endblock %}
{% block preheader %}Rent for {{ unit_ref }} is due on {{ due_date }}.{% endblock %}

{% block content %}
<h1>Rent payment reminder.</h1>
<p>Hi {{ resident_name }},</p>
<p>This is a friendly reminder that your rent payment is due soon.</p>
<div class="highlight-box">
  <p class="section-label">Payment details</p>
  <table class="meta-table">
    <tr>
      <td class="meta-label">Unit</td>
      <td class="meta-value">{{ unit_ref }}</td>
    </tr>
    <tr>
      <td class="meta-label">Amount due</td>
      <td class="meta-value">KES {{ amount_kes }}</td>
    </tr>
    <tr>
      <td class="meta-label">Due date</td>
      <td class="meta-value">{{ due_date }}</td>
    </tr>
  </table>
</div>
<div class="cta-wrap">
  <a href="{{ payment_url }}" class="cta">Pay Now</a>
</div>
<p class="note">
  If you have already made this payment, please disregard this reminder.
  Late payments may attract a fee as outlined in your lease agreement.
</p>
{% endblock %}
