{% extends "base.html.jinja" %}

{% block title %}Welcome to Emakao{% endblock %}
{% block preheader %}Your Emakao account is ready. Sign in to continue.{% endblock %}

{% block content %}
<h1>Welcome to Emakao, {{ first_name }}.</h1>
<p>
  Your account is ready. Sign in any time to manage your profile, review activity,
  and stay connected to the services available to you.
</p>
<div class="cta-wrap">
  <a href="{{ login_url }}" class="cta">Log In to Your Account</a>
</div>
<p class="note">
  If you did not create this account, please contact support immediately.
</p>
{% endblock %}
