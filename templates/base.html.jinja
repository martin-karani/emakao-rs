<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% block title %}Emakao{% endblock %}</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background: #f3f6fb;
      color: #1f2937;
      font-family: Arial, Helvetica, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    a {
      color: #1f5eff;
    }
    .preheader {
      display: none !important;
      visibility: hidden;
      opacity: 0;
      color: transparent;
      height: 0;
      width: 0;
      overflow: hidden;
      mso-hide: all;
    }
    .page {
      padding: 32px 16px;
    }
    .wrapper {
      max-width: 640px;
      margin: 0 auto;
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 12px 36px rgba(15, 23, 42, 0.08);
    }
    .header {
      background: linear-gradient(135deg, #103b73 0%, #1f5eff 100%);
      padding: 32px 40px 28px;
    }
    .brand-kicker {
      display: inline-block;
      padding: 6px 10px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.14);
      color: #dbeafe;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .header-title {
      margin: 16px 0 6px;
      color: #ffffff;
      font-size: 28px;
      line-height: 1.2;
      font-weight: 700;
    }
    .header-copy {
      margin: 0;
      color: rgba(255, 255, 255, 0.88);
      font-size: 15px;
      line-height: 1.6;
    }
    .body {
      padding: 40px;
      color: #374151;
      font-size: 15px;
      line-height: 1.7;
    }
    .body h1,
    .body h2,
    .body h3 {
      margin: 0 0 14px;
      color: #0f172a;
      line-height: 1.3;
    }
    .body h1,
    .body h2 {
      font-size: 26px;
    }
    .body p {
      margin: 0 0 16px;
    }
    .body strong {
      color: #111827;
    }
    .cta-wrap {
      margin: 28px 0 24px;
    }
    .cta {
      display: inline-block;
      padding: 14px 24px;
      background: #f97316;
      color: #ffffff !important;
      text-decoration: none;
      border-radius: 12px;
      font-weight: 700;
      font-size: 15px;
      line-height: 1;
    }
    .cta-secondary {
      background: #0f172a;
    }
    .divider {
      border: none;
      border-top: 1px solid #e5e7eb;
      margin: 28px 0;
    }
    .highlight-box,
    .info-card {
      background: #f8fafc;
      border: 1px solid #e5e7eb;
      border-radius: 16px;
      padding: 18px 20px;
      margin: 20px 0;
    }
    .highlight-box {
      border-left: 4px solid #1f5eff;
    }
    .section-label {
      margin: 0 0 12px;
      color: #0f172a;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .bullet-list {
      margin: 12px 0 0;
      padding-left: 18px;
      color: #475569;
    }
    .bullet-list li {
      margin: 0 0 8px;
    }
    .meta-table {
      width: 100%;
      border-collapse: collapse;
    }
    .meta-table td {
      padding: 8px 0;
      border-bottom: 1px solid #e5e7eb;
      vertical-align: top;
    }
    .meta-table tr:last-child td {
      border-bottom: none;
    }
    .meta-label {
      color: #64748b;
      width: 42%;
      padding-right: 12px;
    }
    .meta-value {
      color: #0f172a;
      font-weight: 600;
    }
    .meta-value-soft {
      color: #334155;
      font-weight: 500;
    }
    .note,
    .small-text {
      color: #6b7280;
      font-size: 13px;
      line-height: 1.6;
    }
    .footer {
      padding: 24px 40px 32px;
      background: #f8fafc;
      border-top: 1px solid #e5e7eb;
      color: #64748b;
      font-size: 12px;
      line-height: 1.6;
      text-align: center;
    }
    .footer p {
      margin: 0 0 8px;
    }
    @media only screen and (max-width: 640px) {
      .page {
        padding: 16px 8px;
      }
      .header,
      .body,
      .footer {
        padding-left: 24px;
        padding-right: 24px;
      }
      .header-title,
      .body h1,
      .body h2 {
        font-size: 22px;
      }
    }
  </style>
</head>
<body>
  <div class="preheader">{% block preheader %}Important account update from Emakao.{% endblock %}</div>
  <div class="page">
    <div class="wrapper">
      <div class="header">
        <div class="brand-kicker">Emakao</div>
        <div class="header-title">Property Operations, Simplified</div>
        <p class="header-copy">
          Secure updates for your account, property activity, and day-to-day workflows.
        </p>
      </div>
      <div class="body">
        {% block content %}{% endblock %}
      </div>
      <div class="footer">
        <p>&copy; {{ current_year }} Emakao. All rights reserved.</p>
        <p>You are receiving this email because you interact with Emakao or one of its managed properties.</p>
        {% if unsubscribe_url %}
        <p><a href="{{ unsubscribe_url }}" style="color:#64748b;">Unsubscribe</a></p>
        {% endif %}
      </div>
    </div>
  </div>
</body>
</html>
