  "query": "\n            SELECT id, property_id, user_id, first_name, last_name, phone, email,\n                   is_active, created_by, created_at, updated_at\n            FROM caretakers\n            WHERE ($1::uuid IS NULL OR property_id = $1::uuid)\n            ORDER BY first_name, last_name\n            LIMIT $2 OFFSET $3\n            ",
