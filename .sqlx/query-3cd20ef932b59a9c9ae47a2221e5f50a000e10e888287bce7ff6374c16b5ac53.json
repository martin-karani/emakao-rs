  "query": "\n        SELECT id, agency_id, owner_id, property_id, amount_kes,\n               method, reference, status, period_start, period_end,\n               notes, created_by, created_at, updated_at\n        FROM disbursements\n        WHERE owner_id = $1\n        ORDER BY created_at DESC\n        LIMIT $2 OFFSET $3\n        ",
