  "query": "\n            SELECT r.id, r.user_id, r.first_name, r.last_name, r.email,\n                   r.phone, r.national_id, r.portal_status, r.created_at, r.updated_at\n            FROM residents r\n            JOIN users u ON u.id = r.user_id\n            WHERE r.id = $1 AND u.agency_id = $2\n            ",
