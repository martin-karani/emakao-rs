  "query": "\n            SELECT\n                id, agency_id, name, address, city, country_code,\n                property_type, config AS \"config: sqlx::types::Json<serde_json::Value>\",\n                created_by, created_at, updated_at\n            FROM properties\n            WHERE agency_id = $1\n              AND ($2::text IS NULL OR property_type = $2)\n            ORDER BY created_at DESC\n            LIMIT $3 OFFSET $4\n            ",
