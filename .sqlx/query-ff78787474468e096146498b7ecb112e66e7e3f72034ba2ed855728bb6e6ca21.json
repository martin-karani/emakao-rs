  "query": "\n            SELECT id, agency_id, user_id, name, contact_name, email, phone,\n                   speciality, status, 'invited'::text as \"portal_status!\",\n                   notes, created_at, updated_at\n            FROM vendors\n            WHERE agency_id = $1\n            ORDER BY name ASC\n            LIMIT $2 OFFSET $3\n            ",
