{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT r.id, r.user_id, r.first_name, r.last_name, r.email,\n                   r.phone, r.national_id, r.portal_status, r.created_at, r.updated_at\n            FROM residents r\n            JOIN users u ON u.id = r.user_id\n            WHERE u.agency_id = $1\n            ORDER BY r.created_at DESC\n            LIMIT $2 OFFSET $3\n            ",
