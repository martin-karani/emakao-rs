  "query": "\n            SELECT id, agency_subscription_id, agency_id, amount_kes, status,\n                   due_date, paid_at, mpesa_ref, mpesa_phone, receipt_url,\n                   notes, created_at\n            FROM subscription_invoices\n            WHERE agency_id = $1\n            ORDER BY created_at DESC\n            LIMIT $2 OFFSET $3\n            ",
